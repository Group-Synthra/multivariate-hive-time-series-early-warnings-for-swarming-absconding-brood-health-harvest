# Historical event-labelled training dataset
HARVEST_HISTORICAL_DATA_PATH=backend/data/hive_data_with_features.csv
HARVEST_LABEL_COLUMN=harvest

# Meaning: harvest=1 is an actual harvest event at that timestamp
HARVEST_PREDICTION_HORIZON_HOURS=72
HARVEST_POST_EVENT_EXCLUSION_HOURS=24
HARVEST_EVENT_MERGE_GAP_HOURS=12
HARVEST_SPLIT_PURGE_HOURS=72
HARVEST_MIN_THRESHOLD_RECALL=0.80

# Historical UK timestamps
HISTORICAL_TIMESTAMPS_ARE_UTC=false
HISTORICAL_SOURCE_TIMEZONE=Europe/London
HISTORICAL_FEATURE_TIMEZONE=Europe/London

# Live Sri Lankan IoT settings
IOT_HISTORY_HOURS=168
IOT_MIN_HISTORY_HOURS=72
IOT_STALE_AFTER_MINUTES=120
IOT_MIN_COMPLETENESS=0.80
IOT_INTERPOLATION_LIMIT_HOURS=3
IOT_LOW_BATTERY_VOLTAGE=3.4
IOT_TIMESTAMPS_ARE_UTC=true
IOT_FEATURE_TIMEZONE=Asia/Colombo
